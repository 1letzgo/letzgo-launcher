<?xml version="1.0" encoding="utf-8"?>
<!--
    Context menus (Launcher3 color): the role of the letzgo surface (surfaceContainerHigh), but
    opaque like M3 menus, so text stays readable over translucent tiles and folders.
-->
<selector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">
    <item android:color="@android:color/system_surface_container_high_dark" />
</selector>
