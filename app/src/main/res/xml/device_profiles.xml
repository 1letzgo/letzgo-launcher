<?xml version="1.0" encoding="utf-8"?>
<!--
    Ersetzt aosp/Launcher3/res/xml/device_profiles.xml. Telefone bekommen ein iOS-artiges Raster;
    die Tablet- und Desktop-Optionen sind unverändert aus AOSP übernommen.
-->
<profiles xmlns:launcher="http://schemas.android.com/apk/res-auto" >

    <!-- iOS-Raster für Telefone: 4 Spalten, 6 Reihen, Dock mit 4 Plätzen, Ordner 3 × 3 -->
    <grid-option
        launcher:name="ios_4_by_6"
        launcher:numRows="6"
        launcher:numColumns="4"
        launcher:numFolderRows="3"
        launcher:numFolderColumns="3"
        launcher:numHotseatIcons="4"
        launcher:numAllAppsColumns="4"
        launcher:dbFile="launcher_ios_4_by_6.db"
        launcher:defaultLayoutId="@xml/default_workspace_ios"
        launcher:deviceCategory="phone|multi_display" >

        <display-option
            launcher:name="Small Phone"
            launcher:minWidthDps="320"
            launcher:minHeightDps="568"
            launcher:iconImageSize="54"
            launcher:iconTextSize="11.5"
            launcher:allAppsBorderSpace="16"
            launcher:allAppsCellHeight="104"
            launcher:canBeDefault="true" />

        <display-option
            launcher:name="Phone"
            launcher:minWidthDps="375"
            launcher:minHeightDps="667"
            launcher:iconImageSize="58"
            launcher:iconTextSize="12.0"
            launcher:allAppsBorderSpace="16"
            launcher:allAppsCellHeight="104"
            launcher:canBeDefault="true" />

        <display-option
            launcher:name="Large Phone"
            launcher:minWidthDps="411"
            launcher:minHeightDps="780"
            launcher:iconImageSize="62"
            launcher:iconTextSize="12.0"
            launcher:allAppsBorderSpace="16"
            launcher:allAppsCellHeight="104"
            launcher:canBeDefault="true" />

    </grid-option>

    <!-- Weniger Reihen: 4 Spalten, 5 Reihen (in den Einstellungen wählbar) -->    <grid-option
        launcher:name="ios_4_by_5"
        launcher:numRows="5"
        launcher:numColumns="4"
        launcher:numFolderRows="3"
        launcher:numFolderColumns="3"
        launcher:numHotseatIcons="4"
        launcher:numAllAppsColumns="4"
        launcher:dbFile="launcher_ios_4_by_5.db"
        launcher:defaultLayoutId="@xml/default_workspace_ios"
        launcher:deviceCategory="phone|multi_display" >

        <display-option
            launcher:name="Small Phone"
            launcher:minWidthDps="320"
            launcher:minHeightDps="568"
            launcher:iconImageSize="54"
            launcher:iconTextSize="11.5"
            launcher:allAppsBorderSpace="16"
            launcher:allAppsCellHeight="104"
            launcher:canBeDefault="false" />

        <display-option
            launcher:name="Phone"
            launcher:minWidthDps="375"
            launcher:minHeightDps="667"
            launcher:iconImageSize="58"
            launcher:iconTextSize="12.0"
            launcher:allAppsBorderSpace="16"
            launcher:allAppsCellHeight="104"
            launcher:canBeDefault="false" />

        <display-option
            launcher:name="Large Phone"
            launcher:minWidthDps="411"
            launcher:minHeightDps="780"
            launcher:iconImageSize="62"
            launcher:iconTextSize="12.0"
            launcher:allAppsBorderSpace="16"
            launcher:allAppsCellHeight="104"
            launcher:canBeDefault="false" />

    </grid-option>

