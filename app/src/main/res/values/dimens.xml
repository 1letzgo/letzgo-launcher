<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keine Google-Suchleiste unter dem Dock -->
    <dimen name="qsb_widget_height">0dp</dimen>
    <dimen name="qsb_shadow_height">0dp</dimen>

    <!-- Abstand der ersten Rasterreihe zur Statusleiste; Heute-Seite und Mediathek beginnen auf
         derselben Höhe (IconGrid.top) -->
    <dimen name="dynamic_grid_edge_margin">14dp</dimen>

    <!-- Dock wie bei iOS etwas über der Gestenleiste -->
    <dimen name="dynamic_grid_hotseat_bottom_tall_padding">12dp</dimen>

    <!-- Context menus lie flat like every letzgo surface; a shadow would show through the
         translucent surface (color-v31/letzgo_surface_*) -->
    <dimen name="deep_shortcuts_elevation">0dp</dimen>

    <!-- App shortcuts in context menus look like the other entries: leading icon at M3 icon size
         (26 dp shows as 24 dp, see Launcher3's comment on deep_shortcut_icon_size), centered on
         the same line as the 20 dp system icons (16 dp margin + 10 dp) -->
    <dimen name="deep_shortcut_icon_size">26dp</dimen>
    <dimen name="popup_padding_start">13dp</dimen>
</resources>
